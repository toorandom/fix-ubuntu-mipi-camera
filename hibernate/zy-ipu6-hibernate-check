#!/bin/sh
# Avisa si la pila de hibernación de la cámara IPU6 no quedó completa para el
# kernel recién instalado. Corre después de 'dkms' (orden alfabético).
# NUNCA debe hacer fallar la instalación de un paquete de kernel.
KVER="$1"
[ -n "$KVER" ] || exit 0
[ -x /usr/local/sbin/ipu6-camera-healthcheck ] || exit 0

out=$(/usr/local/sbin/ipu6-camera-healthcheck "$KVER" 2>/dev/null) && exit 0

cat >&2 <<EOF

**********************************************************************
  CÁMARA IPU6: la pila de hibernación NO quedó completa para $KVER

$(printf '%s\n' "$out" | sed 's/^/    - /')

  Al arrancar con ese kernel la cámara no volverá de hibernar.
  Para arreglarlo:

    sudo apt install linux-headers-$KVER
    cd ~/fix-ubuntu-mipi-camera && sudo bash ipu6-hibernate-fix.sh

  Diagnóstico:  sudo ipu6-camera-healthcheck $KVER
**********************************************************************

EOF
exit 0
