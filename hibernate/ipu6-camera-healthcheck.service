[Unit]
Description=Avisa si la pila de hibernación de la cámara IPU6 está incompleta
After=graphical-session.target

[Service]
Type=oneshot
# Espera un poco: DKMS y los módulos ya están, pero el shell de GNOME puede no
# tener aún servidor de notificaciones nada más iniciar sesión.
ExecStartPre=/usr/bin/sleep 25
ExecStart=/usr/local/bin/ipu6-camera-notify

[Install]
WantedBy=graphical-session.target
