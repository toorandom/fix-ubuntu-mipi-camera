#!/bin/bash
# El ov02c10 va montado girado 180°: sin esto la imagen sale cabeza abajo.
# Lo lanza udev cuando aparece el subdev del sensor (al arrancar y en cada
# re-probe tras hibernar). Recibe el nombre de kernel, p.ej. v4l-subdev7.
#
# Por qué vigila tanto rato en vez de escribir una vez:
#   - ipu_bridge hace un re-probe diferido justo después del evento udev
#     ("ov02c10 bound after delay") y ese bind reinicializa los registros;
#   - v4l2-relayd arranca ~100 ms después que nosotros y el HAL de Intel
#     configura el sensor por su cuenta. Verificar durante 1,5 s caía dentro
#     de esa ventana y daba un falso "ya está" (visto el 2026-10-11: servicio
#     OK a las 16:17:59, relayd levantado a las 16:17:59.01, imagen al revés).
# Así que se pone, y se vigila que SIGA puesto durante bastantes segundos.
name="${1:-}"; [ -n "$name" ] || exit 0
dev="/dev/$name"

VIGILANCIA=45      # iteraciones de 0.5 s -> ~22 s
ESTABLE_MIN=16     # ~8 s seguidos sin que nadie los toque

flips_ok() {
    local out
    out=$(v4l2-ctl -d "$dev" --list-ctrls 2>/dev/null) || return 1
    grep -q 'horizontal_flip.*value=1' <<<"$out" &&
    grep -q 'vertical_flip.*value=1'   <<<"$out"
}

for _ in $(seq 1 25); do
    [ -e "$dev" ] && v4l2-ctl -d "$dev" --list-ctrls 2>/dev/null \
        | grep -q horizontal_flip && break
    sleep 0.2
done
[ -e "$dev" ] || exit 0

estable=0; reintentos=0
for _ in $(seq 1 $VIGILANCIA); do
    if ! flips_ok; then
        timeout 5 v4l2-ctl -d "$dev" \
            --set-ctrl=horizontal_flip=1,vertical_flip=1 2>/dev/null
        estable=0; reintentos=$((reintentos + 1))
    else
        estable=$((estable + 1))
        [ "$estable" -ge "$ESTABLE_MIN" ] && {
            [ "$reintentos" -gt 1 ] && \
                logger -t ipu6-sensor-orientation \
                       "flips fijados tras $reintentos reintentos en $dev"
            exit 0
        }
    fi
    sleep 0.5
done
logger -t ipu6-sensor-orientation \
       "los flips no se mantuvieron estables en $dev; usa 'voltear-camara'"
exit 0
