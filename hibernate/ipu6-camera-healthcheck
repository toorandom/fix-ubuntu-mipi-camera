#!/bin/bash
# ¿Está completa la pila de hibernación de la cámara IPU6 para un kernel dado?
#
# Uso: ipu6-camera-healthcheck [KVER]        (por defecto, el kernel en marcha)
# Salida: 0 todo bien, 1 hay algo roto. Los problemas van a stdout, una línea
# cada uno. Pensado para que lo llamen el hook de kernel y el aviso de sesión.
#
# Los tres módulos TIENEN que venir de updates/dkms: si ov02c10 sale del árbol
# del kernel es el de serie, sin i2c_device_id, y el cliente i2c que ipu_bridge
# instancia tras S4 no enlazará con nada -> cámara muerta al volver de hibernar.
KVER="${1:-$(uname -r)}"
problemas=()

dkms status mei-vsc-hibernate 2>/dev/null | grep -q "$KVER" \
    || problemas+=("DKMS no tiene mei-vsc-hibernate para $KVER (¿faltan linux-headers-$KVER?)")

for m in ipu-bridge mei-vsc ov02c10; do
    p=$(modinfo -k "$KVER" -n "$m" 2>/dev/null)
    case "$p" in
        */updates/dkms/*) ;;
        "")  problemas+=("$m no existe para $KVER") ;;
        *)   problemas+=("$m sale de $p, no de updates/dkms") ;;
    esac
done

modinfo -k "$KVER" ov02c10 2>/dev/null | grep -q 'alias:.*i2c:ov02c10' \
    || problemas+=("ov02c10 sin alias i2c:ov02c10 — el cliente post-S4 no enlazará")

# systemd-sleep ejecuta TODO lo que tenga +x, mire o no la extensión.
for d in /usr/lib/systemd/system-sleep /lib/systemd/system-sleep; do
    [[ -d "$d" ]] || continue
    for f in "$(readlink -f "$d")"/50-ipu6-camera*; do
        [[ -x "$f" ]] && problemas+=("hook en conflicto activo: $f (cuelga la hibernación)")
    done
done

((${#problemas[@]} == 0)) && exit 0
printf '%s\n' "${problemas[@]}"
exit 1
